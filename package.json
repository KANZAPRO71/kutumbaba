{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "description": "Jarvis — a voice-first personal AI assistant that talks, listens, and remembers what matters about you. Powered by your own Google Gemini API key. Private by design.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "android:open": "cap open android",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
